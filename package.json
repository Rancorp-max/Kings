{
  "name": "partydeck",
  "private": true,
  "description": "PartyDeck — phone-based party games (serverless API deps only; the site in public/ needs no build).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build:pages": "node scripts/build-pages.js",
    "mint-codes": "node scripts/mint-codes.js",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.js",
    "test:load": "node tests/load/wedding-load.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "firebase-admin": "^14.5.0",
    "stripe": "^22.6.2"
  }
}
