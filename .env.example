# Copy to .env.local for local dev (npm run dev). On Vercel set these under Project → Settings → Environment Variables.
# Never commit real values.

# Firestore (Firebase project → Service accounts → Generate new private key). Paste the JSON (raw or base64).
FIREBASE_SERVICE_ACCOUNT=

# Stripe (test keys until onboarding is done): sk_test_… and the signing secret of the webhook endpoint
# https://<your-domain>/api/stripe-webhook listening to checkout.session.completed + checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic API key for /api/generate-deck (server-side only). Set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=

# Password for /admin
ADMIN_PASSWORD=

# Optional: canonical base URL for Stripe redirects (defaults to the request's host)
PUBLIC_BASE_URL=

# Dev/test only — never set these in production:
# ALLOW_MOCK_PAYMENTS=1   simulated checkout (auto-on for Vercel preview deploys without Stripe keys)
# MOCK_AI=1               offline fake model for /api/generate-deck
